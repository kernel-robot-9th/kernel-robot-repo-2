# ---- 루트 compose 공용 환경변수. cp .env.example .env 후 수정 ----
JWT_SECRET=change-me-openssl-rand-hex-32   # 백엔드 토큰 서명. 비어 있으면 api 기동 실패
SEED=1                                      # 1이면 api 기동 시 scripts.seed 실행 (N001/nurse1234). 두 번째부터는 0
VITE_API_URL=/api/v1                        # 브라우저가 부르는 백엔드 주소. /api/v1이면 Vite 프록시 경유(어느 IP로 접속해도 동작)
# NURSE_RECEIPT_METHOD=button   # 간호사 배송 수령: button("받았습니다", 2026-10-22 기본) | marker(로봇이 일회용 마커를 읽음)
# AUTH_DISABLED=0               # 1이면 로그인(JWT) 끔 — 같은 LAN 누구나 관리자(N001). 시연·시험 때만 (2026-10-22)
# ROBOT_KEY_DISABLED=0          # 1이면 로봇 API 키 끔 — 키 없이 부르면 로봇 1호로. 시연·시험 때만 (2026-10-22)
# VOICE_PARSER=disabled         # gemini면 음성 배송 예약 초안 켬 — 녹음·문장이 Google 클라우드로 나간다. 시연·시험 때만 (2026-10-26)
# GEMINI_API_KEY=               # VOICE_PARSER=gemini일 때 필요. 이 파일(.env)에만 두고 커밋·문서에 넣지 않는다
# FMS_BASE_URL=                 # 팀원 FMS API v1 주소(예 http://192.168.129.50:8770). 비우면 끔 — 켜면 신청을 FMS로 보내고 claim은 막힌다 (2026-10-27)
# FMS_OMX_ENABLED=0             # 1이면 FMS 묶음을 실제 OMX로 싣는다(/command {blue, green} → ready → /pinky → loaded). 로봇팔이 움직인다
# OMX_BASE_URL=http://10.42.0.147:8000   # 팀원 OMX(10-28). 이 PC가 'shared' 망이면 컨테이너가 못 닿음 → 중계 주소(예 http://172.18.0.1:18000)
# FMS_PHARMACY_SIGNAL=fms       # pinky = 실물 Pinky의 POST /robot/arrived(정밀 주차 끝)를 받은 뒤 OMX 내려놓기 — FMS가 가상인 동안 (10-28)
# OMX_COMMAND_FORMAT=counts     # sentence = 임시: OMX에 수량 무시하고 "pick and place blue gauze" 문장 하나 (실제 OMX가 개수 형식을 받기 전까지)
# VOICE_TTS_VOICE_FEMALE=Kore   # 안내 음성 voice:"female" (2026-10-27)
# VOICE_TTS_VOICE_MALE=Algenib  # 안내 음성 voice:"male"
