<?xml version="1.0"?>
<!-- VLA tabletop: robot base (link0) at world origin, table = ground plane (z=0).
     ArUco DICT_5X5_100 ids 0-3, 5 cm, centers at {0: (0.05, 0.2), 1: (0.33, 0.2), 2: (0.33, -0.2), 3: (0.05, -0.2)} (base frame, m).
     Top-down camera publishes camera/image_raw + camera/camera_info. -->
<sdf version="1.10">
  <world name="vla_table">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="top_camera">
      <static>true</static>
      <pose>0.19 0 0.75 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="top_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>camera/image_raw</topic>
          <gz_frame_id>top_camera_optical</gz_frame_id>
          <camera>
            <camera_info_topic>camera/camera_info</camera_info_topic>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <include><uri>model://aruco_0</uri><name>aruco_0</name><pose>0.05 0.2 0 0 0 0</pose></include>
    <include><uri>model://aruco_1</uri><name>aruco_1</name><pose>0.33 0.2 0 0 0 0</pose></include>
    <include><uri>model://aruco_2</uri><name>aruco_2</name><pose>0.33 -0.2 0 0 0 0</pose></include>
    <include><uri>model://aruco_3</uri><name>aruco_3</name><pose>0.05 -0.2 0 0 0 0</pose></include>

    <model name="block_red">
      <pose>0.18 0.08 0.0125 0 0 0.0</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>2.083e-06</ixx><iyy>2.083e-06</iyy><izz>2.083e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>1</kd><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="block_green">
      <pose>0.2 -0.07 0.0125 0 0 0.4</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>2.083e-06</ixx><iyy>2.083e-06</iyy><izz>2.083e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>1</kd><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="block_blue">
      <pose>0.14 -0.13 0.0125 0 0 0.0</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>2.083e-06</ixx><iyy>2.083e-06</iyy><izz>2.083e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>1</kd><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="block_yellow">
      <pose>0.24 0.02 0.0125 0 0 0.0</pose>
      <link name="link">
        <inertial><mass>0.02</mass>
          <inertia><ixx>2.083e-06</ixx><iyy>2.083e-06</iyy><izz>2.083e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>1</kd><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
