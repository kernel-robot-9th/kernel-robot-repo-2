<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vla_calibration</name>
  <version>0.1.0</version>
  <description>Calibration tools: camera intrinsics, block colors, marker-robot frame, wrist grasp check</description>
  <maintainer email="leval5716@gmail.com">fastcamp1</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>vla_interfaces</exec_depend>
  <exec_depend>vla_perception</exec_depend>
  <exec_depend>vla_executor</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
